<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- AssemblyTitle/Product drive the "Description"/"Product name" fields Explorer shows
         in the .exe's Properties dialog - without these they default to the bare assembly
         name (MelostixClient), not the display name used everywhere else. -->
    <AssemblyTitle>Melostix - Windows Client</AssemblyTitle>
    <Product>Melostix - Windows Client</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon (above) only covers the .exe file's icon: the Window.Icon in XAML
         resolves it at runtime as a resource packed into the assembly, it must be included
         explicitly here or "Icon="app.ico"" in MainWindow.xaml throws IOException at startup. -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
